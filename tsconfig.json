{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "noEmit": true,

    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "asian/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "results"
  ]
}
